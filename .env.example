# =============================================
# Environment Variables — EXAMPLE
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# =============================================

# ---------- Server ----------
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173

# ---------- Database ----------
# For local docker-compose
POSTGRES_PASSWORD=devpassword123
DATABASE_URL=postgresql://postgres:devpassword123@localhost:5433/ecommerce_db?schema=public

# ---------- JWT ----------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-32-char-random-string
JWT_REFRESH_SECRET=replace-with-another-32-char-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Stripe (test mode) ----------
# Get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
# Get from: stripe listen --forward-to localhost:3000/api/v1/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# ---------- Email (SMTP) ----------
# Gmail: enable 2FA, then create App Password at https://myaccount.google.com/apppasswords
# Other providers: Brevo, SendGrid, Resend, Mailgun — any SMTP works
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_SECURE=false



# ---------- Seed (development only) ----------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Admin
DEMO_CUSTOMER_EMAIL=customer@example.com
DEMO_CUSTOMER_PASSWORD=Customer@123456




# Trust the X-Forwarded-For header (set to "true" when behind a reverse proxy like Render/Heroku)
TRUST_PROXY=false