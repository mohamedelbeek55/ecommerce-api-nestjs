# Copy this file to .env and fill in your values
# Never commit .env to version control
# Generate your own JWT secrets, e.g.: openssl rand -hex 32
# Do NOT reuse the placeholder-shaped values below — they are examples only, not real secrets

DATABASE_URL="postgresql://postgres:password@localhost:5433/ecommerce_db?schema=public"
POSTGRES_PASSWORD="replace-with-your-postgres-password"
JWT_ACCESS_SECRET="replace-with-your-own-random-secret-min-32-chars-openssl-rand-hex-32"
JWT_REFRESH_SECRET="replace-with-a-different-random-secret-min-32-chars-openssl-rand-hex-32"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=3000
NODE_ENV=development
STRIPE_SECRET_KEY="sk_test_replace_with_your_stripe_test_secret"
STRIPE_WEBHOOK_SECRET="whsec_replace_with_your_stripe_webhook_secret"
