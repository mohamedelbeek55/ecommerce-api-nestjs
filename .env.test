# =============================================
# Test environment variables
# These are DUMMY values used only for running tests.
# Never use real secrets here — this file IS committed to git.
# =============================================

NODE_ENV=test

# Database (matches docker-compose test service)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ecommerce_test

# JWT secrets — dummy values, 32+ chars each
JWT_ACCESS_SECRET=test_access_secret_at_least_32_characters_long_xyz
JWT_REFRESH_SECRET=test_refresh_secret_at_least_32_characters_long_abc
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stripe (test placeholders)
STRIPE_SECRET_KEY=sk_test_dummy_key_for_testing_only
STRIPE_WEBHOOK_SECRET=whsec_dummy_secret_for_testing_only

# Server
PORT=3000

# Email (dummy — tests will mock the actual sending)
EMAIL_HOST=smtp.test.local
EMAIL_PORT=587
EMAIL_USER=test@example.com
EMAIL_PASS=test-password
EMAIL_FROM=test@example.com
EMAIL_SECURE=false

# Frontend
FRONTEND_URL=http://localhost:3000